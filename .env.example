# Copy to .env (read from the working directory) and uncomment what you want to change.
# Defaults are shown; variables already set in the environment take precedence.

# MCP HTTP server (streamable-http transport). It listens on 127.0.0.1 only;
# use a reverse proxy for remote access, or set AH_MCP_HOST=0.0.0.0.
# AH_MCP_HOST=127.0.0.1
# AH_MCP_PORT=3000
# AH_MCP_BASE_URL=http://localhost:3000

# Secret token required on every HTTP request; the HTTP transport doesn't start
# without it. Generate one with: openssl rand -hex 32
# AH_MCP_TOKEN=

# Do not try to open a browser on login (same as --remote).
# AH_REMOTE=false

# Token storage path (default: XDG config dir, e.g. ~/.config/albert-heijn-mcp/tokens.json).
# AH_TOKENS_PATH=

# Also append logs to this file (logs always go to stderr).
# AH_LOG_FILE=
